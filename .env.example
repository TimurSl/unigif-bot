# Copy to .env and fill in. Nothing here is committed: .env is in .gitignore.

# From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# Your Unigif server, and an API key for the bot with the "read" scope
# (create one in Unigif under Keys, preset "Read-only", or: unigif key create --name telegram --preset read_only).
UNIGIF_URL=https://gif.example.com
UNIGIF_API_KEY=

# Who may use the bot: Telegram user ids, comma separated. Send any message to the bot from an
# unlisted account and it replies with that account's id.
ALLOWED_USER_IDS=
# ...or, to let anyone on Telegram search your library:
# ALLOW_ANYONE=true

# Strongly recommended: a private chat or channel the bot can post in (add the bot as an admin of a
# private channel, then use its id, such as -1001234567890). GIFs too big for an inline URL are uploaded
# here once and reused.
# STORAGE_CHAT_ID=

# Optional
# DATA_DIR=./data               # holds file-ids.json, the cache of Telegram file ids
# SORT=used                     # used | new | old
# INLINE_PAGE_SIZE=30           # 1-50
# CHAT_PAGE_SIZE=5              # 1-10 GIFs per search in a chat
# INLINE_URL_MAX_BYTES=1000000  # biggest MP4 offered to Telegram by URL
# MAX_UPLOAD_BYTES=20000000     # biggest MP4 the bot will download and upload
# INLINE_UPLOAD_BUDGET_MS=4000  # how long an inline query waits for uploads
# INLINE_CACHE_SECS=30
# LOG_LEVEL=info                # debug | info | warn | error
