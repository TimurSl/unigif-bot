{
  "name": "unigif-bot",
  "version": "0.1.0",
  "description": "Telegram bot for a Unigif server: search your GIF library by hashtag and send any GIF, inline or in chat.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "bin": {
    "unigif-bot": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-reporter=spec test/*.test.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
